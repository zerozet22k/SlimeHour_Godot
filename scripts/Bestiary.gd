extends RefCounted
## Bestiary combat descriptions, kept separate from card collection data.
const NOTES = {"blob":["BASIC CHASER","Moves straight toward you.","Group blobs for piercing or area damage."],"zoomer":["SPRINTER","Fast movement, low HP.","Defeat before it reaches you."],"nurse":["HEALER","Restores 12% max HP to injured enemies within 170 units.","Focus Nurses before armored enemies."],"spitter":["RANGED","Fires aimed shots; triple spread after Sector 6.","Strafe its projectiles."],"kaboomba":["EXPLOSIVE","Explodes in a radius of 85 when defeated.","Finish from outside the blast."],"chonk":["HEAVY","High HP; uses a belly flop from Sector 4.","Leave the 115-unit slam telegraph."],"mitosis":["SPLITTER","Spawns two Minis when killed.","Keep an area attack ready."],"mini":["SMALL CHASER","Low-health minion spawned by other monsters.","Clear with wide fire."],"riot":["SHIELDED","Reduces direct hits from the direction its shield faces.","Flank it or use explosives."],"bull":["CHARGER","Pauses to telegraph a straight-line charge.","Dash sideways."],"larry":["LASER SNIPER","Aims and fires an instant beam.","Move after the aim locks."],"mama":["SUMMONER","Spawns two Minis approximately every four seconds.","Prioritize before the crowd expands."],"mortar":["ARTILLERY","Marks where its predicted shell will land.","Move out of the marked circle."],"totem":["STATIC","Stays stationary while supporting the mob.","Destroy when safe."],"blinky":["TELEPORTER","Pauses, then teleports close to your location.","Leave its destination indicator."],"tick":["LATCHER","Can latch onto you at close range.","Push it away before contact."],"goblin":["LOOT","Runs away and disappears after twelve seconds.","Catch it for bonus gold."],"chonkzilla":["BOSS: SLAM","Large 160-radius belly slam plus radial projectiles.","Dash out before the slam."],"heli":["BOSS: AIR","Hovering bullet bursts and Kaboomba reinforcements.","Keep moving; clear the spawns."],"necro":["BOSS: MAGIC","Homing skulls and summoned blobs.","Avoid skulls and clear the swarm."],"kingblob":["BOSS: SPLIT","Teleports onto you, then splits into smaller Kings.","Avoid the landing marker and preserve your dash."]}
static func info(kind: String) -> Array:
	return NOTES.get(kind, ["UNKNOWN", "No information available.", "Watch this enemy carefully."])
